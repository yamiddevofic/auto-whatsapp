# Copia este archivo a .env y complétalo. NUNCA pongas valores reales aquí.

# --- Servidor ---
PORT=3001
# Escuchar sólo en localhost: nginx (o un túnel) es la única entrada desde fuera
BIND_ADDR=127.0.0.1
NODE_ENV=production
# true sólo si un proxy sirve la app por HTTPS (activa HSTS y cookies Secure)
BEHIND_TLS=
LOG_LEVEL=info

# Directorio de datos (sesión de WhatsApp, base de datos, adjuntos).
# Fuera del árbol servido por el servidor web. En producción: /var/lib/auto-whatsapp
DATA_DIR=

# Orígenes permitidos por CORS, separados por comas.
# Vacío = sólo mismo origen (recomendado, ya que Express sirve también el frontend).
ALLOWED_ORIGIN=

# --- Autenticación ---
AUTH_USERNAME=
# Hash bcrypt de la contraseña:  npm run hash-password -- 'TuContraseña'
AUTH_PASSWORD_HASH=
# Secreto de firma del JWT, mínimo 32 caracteres:  openssl rand -base64 48
AUTH_SECRET=
# Duración del token de sesión
AUTH_TOKEN_TTL=8h

# --- Retención de datos ---
# Días que se conservan los mensajes ya enviados/fallidos (0 = sin purga automática)
RETENTION_DAYS=90

# --- WhatsApp ---
SESSION_NAME=whatsapp
# Sólo diagnóstico: ruta de un archivo donde volcar todo el tráfico del protocolo.
# Contiene metadatos de tus chats: déjalo vacío en uso normal y borra el archivo después.
WA_TRACE_FILE=
